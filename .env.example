# ====================================================================
# Plantilla de Variables de Entorno - Mini-Azure LUIS
# Copiar este archivo a .env y configurar los valores correspondientes
# ====================================================================

# Configuración del Servidor NLP (Integrante A)
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
CONFIDENCE_THRESHOLD=0.65
DATASET_PATH=/app/data/dataset_agro.csv
MODEL_DIR=/app/models
STATS_FILE=/app/data/historial.json

# Configuración del Cliente / Dashboard (Integrante B)
# En pruebas locales: 127.0.0.1
# En laboratorio LAN: Cambiar a la IP de la máquina Servidor (ej. 192.168.1.XX)
TARGET_SERVER_IP=127.0.0.1
